@import "layout/*"
@import "widgets/*"
@import "widgets/index/*"

body 
    font-family: 'lxwk', 'dingtalk', 'pingfang','banner',sans-serif

html,
body
    margin: 0

html,
body
    margin: 0
    overflow-x: clip

.main
    min-height: calc(100vh - 64px)
    border-radius: var(--s-shape-corner-large)
    transition: margin-left 0.25s var(--s-motion-easing-standard)

/* ===== 顶栏毛玻璃模糊效果 ===== */
.top-app-bar
    position: sticky
    top: 0
    z-index: 1000
    background-color: unquote('color-mix(in srgb, var(--s-color-surface) 72%, transparent)')
    backdrop-filter: blur(20px) saturate(180%)
    -webkit-backdrop-filter: blur(20px) saturate(180%)
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease

.top-app-bar::part(layout)
    background: transparent

/* ===== 弹窗高斯模糊（Sober UI s-dialog） ===== */
s-dialog::part(popover)::backdrop
    background-color: rgba(0, 0, 0, 0.25)
    backdrop-filter: blur(40px) saturate(180%)
    -webkit-backdrop-filter: blur(40px) saturate(180%)

s-dialog::part(popover)
    background-color: unquote('color-mix(in srgb, var(--s-color-surface-container-high) 82%, transparent)') !important
    backdrop-filter: blur(30px) saturate(160%)
    -webkit-backdrop-filter: blur(30px) saturate(160%)

/* ===== Snackbar 通知（Sober UI 风格） ===== */
.materialis-snackbar-region
    position: fixed
    bottom: 24px
    left: 50%
    transform: translateX(-50%)
    z-index: 10000
    display: flex
    flex-direction: column
    align-items: center
    gap: 8px
    pointer-events: none

.materialis-snackbar
    display: inline-flex
    align-items: center
    gap: 8px
    max-width: 90vw
    padding: 10px 18px
    border-radius: 999px !important
    background: var(--s-color-inverse-surface)
    color: unquote('var(--s-color-inverse-on-surface, var(--s-color-on-error))')
    font-size: 0.875rem
    line-height: 1.4
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2)
    backdrop-filter: blur(12px)
    -webkit-backdrop-filter: blur(12px)
    opacity: 0
    transform: translateY(16px) scale(0.9)
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1)
    pointer-events: auto

.materialis-snackbar.is-visible
    opacity: 1
    transform: translateY(0) scale(1)

.materialis-snackbar material-icon
    font-size: 18px
    flex-shrink: 0

.materialis-snackbar[data-type="success"] material-icon
    color: var(--s-color-primary)

.materialis-snackbar[data-type="error"]
    background: var(--s-color-error)
    color: var(--s-color-on-error)

.materialis-snackbar[data-type="error"] material-icon
    color: var(--s-color-on-error)

@media (max-width: 600px)
    .materialis-snackbar-region
        bottom: 16px
        width: calc(100% - 32px)

    .materialis-snackbar
        max-width: 100%
        padding: 10px 14px
        font-size: 0.82rem

/* ===== 全局回到顶部 FAB ===== */
.back-to-top-fab
    position: fixed
    right: 24px
    bottom: 90px
    z-index: 9000
    opacity: 0
    visibility: hidden
    transform: translateY(16px) scale(0.85)
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.3s ease

.back-to-top-fab::part(text)
    display: flex
    align-items: center
    justify-content: center
    line-height: 1

.back-to-top-fab.is-visible
    opacity: 1
    visibility: visible
    transform: translateY(0) scale(1)

.back-to-top-fab:hover
    transform: translateY(-2px) scale(1.05)

@media (max-width: 600px)
    .back-to-top-fab
        right: 16px
        bottom: 76px

/* ===== 阅读进度条（仅文章页） ===== */
.reading-progress-bar
    position: fixed
    top: 0
    left: 0
    right: 0
    height: 3px
    z-index: 1001
    background: transparent
    pointer-events: none

.reading-progress-fill
    height: 100%
    width: 0
    background: linear-gradient(90deg,
        unquote('var(--s-color-primary)'),
        unquote('var(--s-color-tertiary)'))
    border-radius: 0 999px 999px 0
    transition: width 0.1s linear
    box-shadow: 0 0 6px unquote('color-mix(in srgb, var(--s-color-primary) 50%, transparent)')

/* ===== 全局滚动条 Sober 风格 ===== */
html
    scrollbar-width: thin
    scrollbar-color: var(--s-color-outline-variant) transparent

html::-webkit-scrollbar
    width: 8px
    height: 8px

html::-webkit-scrollbar-track
    background: transparent

html::-webkit-scrollbar-thumb
    background: unquote('color-mix(in srgb, var(--s-color-outline-variant) 40%, transparent)')
    border-radius: 999px
    transition: background 0.2s ease

html::-webkit-scrollbar-thumb:hover
    background: var(--s-color-outline)

/* 代码块滚动条更细 */
.mac-code-block pre::-webkit-scrollbar
    width: 6px
    height: 6px

/* 桌面端（>= 840px）：侧边栏默认常显 */
@media screen and (min-width: 840px)
    .main
        margin-left: 312px

    body:not(.sidebar-is-open) .main
        margin-left: 0
