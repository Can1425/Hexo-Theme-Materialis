@import "layout/*"
@import "widgets/*"
@import "widgets/index/*"

body 
    font-family: 'lxwk', 'dingtalk', 'pingfang','banner',sans-serif

html,
body
    margin: 0

html,
body
    margin: 0

.main
    border-radius: var(--mdui-shape-corner-large)

/* ===== 顶栏毛玻璃模糊效果 ===== */
.top-app-bar::part(container)
    background-color: unquote('rgb(var(--mdui-color-surface) / 0.72)')
    backdrop-filter: blur(20px) saturate(180%)
    -webkit-backdrop-filter: blur(20px) saturate(180%)
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease

/* ===== 全局回到顶部 FAB ===== */
.back-to-top-fab
    position: fixed
    right: 24px
    bottom: 90px
    z-index: 9000
    opacity: 0
    visibility: hidden
    transform: translateY(16px) scale(0.85)
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.3s ease

.back-to-top-fab.is-visible
    opacity: 1
    visibility: visible
    transform: translateY(0) scale(1)

.back-to-top-fab:hover
    transform: translateY(-2px) scale(1.05)

@media (max-width: 600px)
    .back-to-top-fab
        right: 16px
        bottom: 76px

/* ===== 全局滚动条 mdui 风格 ===== */
html
    scrollbar-width: thin
    scrollbar-color: unquote('rgb(var(--mdui-color-outline-variant))') transparent

html::-webkit-scrollbar
    width: 8px
    height: 8px

html::-webkit-scrollbar-track
    background: transparent

html::-webkit-scrollbar-thumb
    background: unquote('rgb(var(--mdui-color-outline-variant) / 0.4)')
    border-radius: 999px
    transition: background 0.2s ease

html::-webkit-scrollbar-thumb:hover
    background: unquote('rgb(var(--mdui-color-outline))')

/* 代码块滚动条更细 */
.mac-code-block pre::-webkit-scrollbar
    width: 6px
    height: 6px

/* 桌面端（>= 840px）：侧边栏默认常显 */
@media screen and (min-width: 840px)
    .sidebar-content
        open: true
