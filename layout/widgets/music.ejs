<% if (theme.music && theme.music.enable) { %>
<style>
/* ===== 音乐播放器 ===== */
.music-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 9000;
    font-family: var(--materialis-font-family);
}

/* 折叠态：使用 Sober 默认 FAB 外观 */
.music-ball {
    position: relative;
}

.music-ball-cover {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.music-ball-cover material-icon {
    color: currentColor;
    font-size: 24px;
}

.music-ball.playing .music-ball-cover {
    animation: music-spin 12s linear infinite;
}

@keyframes music-spin {
    to { transform: rotate(360deg); }
}

/* 展开态：播放面板 */
.music-panel {
    position: absolute;
    bottom: 70px;
    right: 0;
    width: 300px;
    padding: 16px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--s-color-surface-container) 82%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 40%, transparent);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12),
                0 2px 8px rgba(0, 0, 0, 0.06);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.25s ease,
                transform 0.25s cubic-bezier(0.2, 0, 0, 1),
                visibility 0.25s;
}

.music-widget.expanded .music-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

.music-panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
}

.music-panel-cover {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-size: cover;
    background-position: center;
    background-color: var(--s-color-primary-container);
    color: var(--s-color-on-primary-container);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.music-panel-cover material-icon {
    font-size: 24px;
}

.music-panel-info {
    flex: 1;
    min-width: 0;
}

.music-panel-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--s-color-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.music-panel-artist {
    font-size: 0.78rem;
    color: var(--s-color-on-surface-variant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
}

.music-close {
    flex-shrink: 0;
    --s-color-on-surface: var(--s-color-on-surface-variant);
}

.music-slider {
    width: 100%;
    margin: 6px 0 2px;
}

.music-time {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--s-color-on-surface-variant);
    margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
}

.music-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.music-play-btn {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 50%;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--s-color-primary) 40%, transparent);
    margin: 0 4px;
}

.music-play-btn:active {
    transform: scale(0.92);
}

.music-play-btn material-icon {
    font-size: 24px;
}

.music-prev-icon,
.music-next-icon {
    --s-color-on-surface: var(--s-color-on-surface-variant);
}

/* 移动端适配 */
@media (max-width: 768px) {
    .music-widget {
        right: 16px;
        bottom: 16px;
    }

    .music-panel {
        width: calc(100vw - 32px);
        max-width: 300px;
        bottom: 62px;
    }
}

/* 尊重减少动画偏好 */
@media (prefers-reduced-motion: reduce) {
    .music-ball.playing .music-ball-cover {
        animation: none;
    }
    .music-panel {
        transition-duration: 0.01ms;
    }
}
</style>

<div class="music-widget" id="music-widget">
    <!-- 折叠态：旋转唱片球 -->
    <s-fab class="music-ball" id="music-ball" aria-label="音乐播放器">
        <span class="music-ball-cover" id="music-ball-cover">
            <material-icon name="music_note"></material-icon>
        </span>
    </s-fab>

    <!-- 展开态：播放面板 -->
    <div class="music-panel" id="music-panel">
        <div class="music-panel-head">
            <span class="music-panel-cover" id="music-panel-cover">
                <material-icon name="music_note"></material-icon>
            </span>
            <div class="music-panel-info">
                <div class="music-panel-title" id="music-panel-title">未在播放</div>
                <div class="music-panel-artist" id="music-panel-artist">- -</div>
            </div>
            <s-icon-button id="music-close" class="music-close" aria-label="收起">
                <material-icon name="close"></material-icon>
            </s-icon-button>
        </div>

        <s-slider id="music-slider" class="music-slider" value="0" max="100"></s-slider>

        <div class="music-time">
            <span id="music-current">0:00</span>
            <span id="music-duration">0:00</span>
        </div>

        <div class="music-controls">
            <s-icon-button id="music-prev" aria-label="上一首">
                <material-icon name="skip_previous" class="music-prev-icon"></material-icon>
            </s-icon-button>
            <s-icon-button variant="filled" class="music-play-btn" id="music-play" aria-label="播放/暂停">
                <material-icon name="play_arrow" id="music-play-icon"></material-icon>
            </s-icon-button>
            <s-icon-button id="music-next" aria-label="下一首">
                <material-icon name="skip_next" class="music-next-icon"></material-icon>
            </s-icon-button>
        </div>
    </div>

    <audio id="music-audio" preload="metadata"></audio>
</div>

<script>
// 注入音乐配置（由主题 _config.yml 生成）
window.MUSIC_CONFIG = {
    api: <%- JSON.stringify(theme.music.api || '') %>,
    playlistId: <%- JSON.stringify(theme.music.playlist_id || '') %>,
    playlist: <%- JSON.stringify(theme.music.playlist || []).split('</' + 'script>').join('<\\/' + 'script>') %>
};
</script>
<script defer src="/js/widgets/music.js"></script>
<% } %>
