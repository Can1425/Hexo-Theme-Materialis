<script>
document.addEventListener('DOMContentLoaded', function() {
  var copyUrlBtn = document.getElementById('copy-url-trigger');
  if (!copyUrlBtn) return;
  copyUrlBtn.addEventListener('click', function() {
    var message = "<%= __('share.copy_success') %>";
    navigator.clipboard.writeText(window.location.href).catch(function() {
      message = "<%= __('share.copy_fail') %>";
    }).finally(function() {
      window.MaterialisUI.notify({ message: message, duration: 2000 });
    });
  });
});
</script>
