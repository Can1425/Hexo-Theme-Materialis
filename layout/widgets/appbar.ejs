<s-app-bar size="auto" media="(max-width: 600px)" class="top-app-bar">
    <s-icon-button slot="nav" class="appbar-menu-button" aria-label="切换导航栏">
        <material-icon name="menu"></material-icon>
    </s-icon-button>
    <div slot="title" class="appbar-title" onclick="window.location.href='<%= url_for('/') %>'">
        <%= config.title %>
    </div>

    <s-nav-adaptive class="appbar-actions" aria-label="页面工具">
        <s-nav-adaptive-item id="display-mode-trigger" selectable="false">
            <material-icon slot="icon" name="auto_mode" class="appbar-display-mode-icon"></material-icon>
            <span slot="text">显示模式</span>
        </s-nav-adaptive-item>
        <s-nav-adaptive-item id="search-toggle" selectable="false">
            <material-icon slot="icon" name="search"></material-icon>
            <span slot="text">搜索</span>
        </s-nav-adaptive-item>
        <s-nav-adaptive-item id="color-picker-trigger" selectable="false">
            <material-icon slot="icon" name="palette"></material-icon>
            <span slot="text">动态配色</span>
        </s-nav-adaptive-item>
        <% if (theme.rss) { %>
        <s-nav-adaptive-item id="rss-trigger" selectable="false" data-rss-url="<%= url_for(theme.rss) %>">
            <material-icon slot="icon" name="rss_feed"></material-icon>
            <span slot="text"><%= __('appbar.rss') %></span>
        </s-nav-adaptive-item>
        <% } %>
        <% if (page && page.layout === 'post') { %>
        <s-nav-adaptive-item id="toc-toggle" selectable="false">
            <material-icon slot="icon" name="menu_book"></material-icon>
            <span slot="text">文章导航</span>
        </s-nav-adaptive-item>
        <s-nav-adaptive-item id="copy-url-trigger" selectable="false">
            <material-icon slot="icon" name="link"></material-icon>
            <span slot="text">复制链接</span>
        </s-nav-adaptive-item>
        <% } %>
        <s-icon-button slot="toggle" aria-label="更多工具">
            <material-icon name="more_vert"></material-icon>
        </s-icon-button>
    </s-nav-adaptive>
</s-app-bar>

<%- partial('widgets/search.ejs') %>
<%- partial('widgets/color.ejs') %>
<% if (page && page.layout === 'post') { %>
    <%- partial('widgets/nav.ejs') %>
<% } %>

<s-dialog id="display-mode-dialog" class="display-mode-dialog">
    <div slot="title" class="materialis-dialog-title">显示模式</div>
    <div slot="text" class="display-mode-options">
        <s-button variant="tonal" class="display-mode-option" data-mode="light">
            <material-icon slot="start" name="light_mode"></material-icon>
            浅色
        </s-button>
        <s-button variant="tonal" class="display-mode-option" data-mode="dark">
            <material-icon slot="start" name="dark_mode"></material-icon>
            深色
        </s-button>
        <s-button variant="tonal" class="display-mode-option" data-mode="auto">
            <material-icon slot="start" name="auto_mode"></material-icon>
            跟随系统
        </s-button>
    </div>
</s-dialog>

<style>
.appbar-title {
    cursor: pointer;
}

.appbar-actions {
    min-width: 0;
}

/* 移动端：强制折叠为单个 more_vert 菜单按钮 */
/* s-nav-adaptive 因 flex-grow:1 占满空间不会自动 collapsed，
   限制宽度后组件原生 ResizeWatcher 会触发 collapsed 状态，
   隐藏所有 nav-adaptive-item 并显示 slot=toggle 里的按钮 */
@media (max-width: 600px) {
    .appbar-actions {
        max-width: 40px;
    }
}

.display-mode-dialog {
    width: 320px;
}

.display-mode-options {
    display: grid;
    gap: 8px;
}

.display-mode-option {
    display: flex;
    justify-content: flex-start;
    width: 100%;
}
</style>
