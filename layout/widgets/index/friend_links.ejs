<style>
/* ===== 友链页（Material Design 3 Expressive · 无边界 + 毛玻璃 + 动画）
   与关于页（有界 blob + 渐变）、归档页（光斑 + 年份卡片）区分：
   采用无阴影、无边框的干净分层 + 毛玻璃卡片，网格卡片逐个入场 */
.friends-page {
    position: relative;
    max-width: 920px;
    margin: 0 auto;
    padding: 40px 20px 64px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 24px;
}

/* s-card 自定义元素默认 display:inline-block / width:360px，在 flex 容器中需显式撑满
   并彻底清除 sober 组件默认阴影（MD3E 无边界规范） */
.friends-page s-card {
    width: 100%;
    box-sizing: border-box;
}

.friends-page s-card,
.friends-page s-avatar,
.friends-page s-badge,
.friends-page s-chip {
    --s-elevation-level1: none !important;
    --s-elevation-level2: none !important;
    --s-elevation-level3: none !important;
    --s-elevation-level4: none !important;
    --s-elevation-level5: none !important;
    box-shadow: none !important;
}

/* ===== 头部（无边界毛玻璃卡片，左对齐） ===== */
.friends-header {
    position: relative;
    z-index: 1;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 28px !important;
    padding: 28px 32px;
    background: color-mix(in srgb, var(--s-color-surface-container) 62%, transparent) !important;
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    color: var(--s-color-on-surface);
}

.friends-header-content {
    display: flex;
    align-items: center;
    gap: 20px;
}

.friends-header-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 18px;
    background: linear-gradient(135deg,
        color-mix(in srgb, var(--s-color-primary-container) 82%, transparent),
        color-mix(in srgb, var(--s-color-secondary-container) 62%, transparent));
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    color: var(--s-color-on-primary-container);
}

.friends-header-icon material-icon {
    font-size: 28px;
}

.friends-header-text {
    flex: 1;
    min-width: 0;
}

.friends-header-text h1 {
    margin: 0 0 6px;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--s-color-on-surface);
}

.friends-header-count {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.75;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--s-color-on-surface);
}

.friends-header-count s-badge {
    background: color-mix(in srgb, var(--s-color-secondary-container) 80%, transparent);
    color: var(--s-color-on-secondary-container);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

/* ===== 友链网格 ===== */
.friends-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
}

/* ===== 友链卡片（无阴影 · 无边框 · 毛玻璃） ===== */
.friend-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    padding: 28px 20px 22px;
    border-radius: 24px !important;
    background: color-mix(in srgb, var(--s-color-surface-container-low) 62%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: var(--s-color-on-surface);
    text-decoration: none;
    transition: background-color 0.35s ease,
                transform 0.35s var(--s-motion-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
}

.friend-card:hover {
    background: color-mix(in srgb, var(--s-color-surface-container) 74%, transparent);
    transform: translateY(-4px);
}

.friend-avatar {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--s-color-primary-container) 60%, transparent);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    color: var(--s-color-on-primary-container);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s var(--s-motion-easing-emphasized, cubic-bezier(0.2, 0, 0, 1));
}

.friend-card:hover .friend-avatar {
    transform: scale(1.08) rotate(-3deg);
}

.friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

.friend-avatar material-icon {
    font-size: 32px;
}

.friend-name {
    margin: 4px 0 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--s-color-on-surface);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
    transition: color 0.3s ease;
}

.friend-card:hover .friend-name {
    color: var(--s-color-primary);
}

.friend-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--s-color-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.65em;
}

.friend-open {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--s-color-primary);
    background: color-mix(in srgb, var(--s-color-primary) 10%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(6px) scale(0.94);
    transition: opacity 0.3s ease, transform 0.35s var(--s-motion-easing-emphasized, cubic-bezier(0.2, 0, 0, 1)),
                background-color 0.3s ease;
}

.friend-card:hover .friend-open {
    opacity: 1;
    transform: translateY(0) scale(1);
}

.friend-open:hover {
    background: color-mix(in srgb, var(--s-color-primary) 16%, transparent);
}

.friend-open material-icon {
    font-size: 1.05rem;
}

/* ===== 空状态（毛玻璃） ===== */
.friends-empty {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 24px;
}

.friends-empty-card {
    width: 100%;
    max-width: 500px;
    box-sizing: border-box;
    padding: 56px 40px;
    text-align: center;
    border-radius: 28px !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: color-mix(in srgb, var(--s-color-surface-container) 60%, transparent) !important;
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    color: var(--s-color-on-surface);
    --s-elevation-level1: none;
    --s-elevation-level2: none;
    --s-elevation-level3: none;
    --s-elevation-level4: none;
    --s-elevation-level5: none;
    box-shadow: none !important;
}

.friends-empty-icon {
    font-size: 64px;
    margin-bottom: 20px;
    opacity: 0.6;
    color: var(--s-color-primary);
}

.friends-empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

/* ===== 入场动画 ===== */
[data-friends-reveal] {
    opacity: 0;
    transform: translateY(24px) scale(0.98);
    transition: opacity 0.55s cubic-bezier(0.05, 0.7, 0.1, 1),
                transform 0.55s cubic-bezier(0.05, 0.7, 0.1, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
}

[data-friends-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* ===== 响应式 ===== */
@media (max-width: 768px) {
    .friends-page {
        padding: 28px 16px 48px;
        gap: 20px;
    }

    .friends-header {
        padding: 24px 20px;
    }

    .friends-header-content {
        gap: 16px;
    }

    .friends-header-icon {
        width: 48px;
        height: 48px;
        border-radius: 15px;
    }

    .friends-header-text h1 {
        font-size: 1.4rem;
    }

    .friends-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 14px;
    }
}

@media (max-width: 480px) {
    .friends-page {
        padding: 20px 12px 40px;
        gap: 16px;
    }

    .friends-header {
        padding: 20px 16px;
    }

    .friends-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
    }

    .friends-header-text h1 {
        font-size: 1.25rem;
    }

    .friends-grid {
        grid-template-columns: 1fr;
    }

    .friend-card {
        flex-direction: row;
        text-align: left;
        padding: 20px;
        gap: 14px;
    }

    .friend-name,
    .friend-desc {
        text-align: left;
    }

    .friend-desc {
        min-height: 0;
    }

    .friend-open {
        margin-top: 2px;
    }
}

@media (prefers-reduced-motion: reduce) {
    [data-friends-reveal] {
        transition: none !important;
        opacity: 1 !important;
        transform: none !important;
    }
}
</style>

<div class="friends-page">
    <!-- 页面头部 -->
    <s-card readonly class="friends-header" data-friends-reveal style="--i:0">
        <div class="friends-header-content">
            <div class="friends-header-icon">
                <material-icon name="link"></material-icon>
            </div>
            <div class="friends-header-text">
                <h1><%= __('friend_links.title') %></h1>
                <% if (site.data.links && site.data.links.length > 0) { %>
                    <p class="friends-header-count">
                        <%= __('friend_links.count_prefix') %>
                        <s-badge><%= site.data.links.length %></s-badge>
                        <%= __('friend_links.count_suffix') %>
                    </p>
                <% } %>
            </div>
        </div>
    </s-card>

    <!-- 友链网格 -->
    <% if (site.data.links && site.data.links.length > 0) { %>
        <div class="friends-grid">
            <% site.data.links.forEach(function(link, index) { %>
                <a href="<%= link.url %>" class="friend-card" target="_blank" rel="noopener noreferrer"
                   data-friends-reveal style="--i:<%= index + 1 %>">
                    <s-avatar class="friend-avatar">
                        <% if (link.avatar) { %>
                            <img src="<%= link.avatar %>" alt="<%= link.name %>" loading="lazy">
                        <% } else { %>
                            <material-icon>person</material-icon>
                        <% } %>
                    </s-avatar>

                    <div class="friend-name"><%= link.name %></div>
                    <% if (link.desc) { %>
                        <div class="friend-desc"><%= link.desc %></div>
                    <% } %>

                    <span class="friend-open">
                        <material-icon name="open_in_new"></material-icon>
                    </span>
                </a>
            <% }); %>
        </div>
    <% } else { %>
        <!-- 空状态 -->
        <div class="friends-empty">
            <s-card readonly class="friends-empty-card">
                <material-icon class="friends-empty-icon">link_off</material-icon>
                <div class="friends-empty-content">
                    <materialis-typography variant="h5" style="margin-bottom: 8px; font-weight: 500;">
                        <%= __('friend_links.empty') %>
                    </materialis-typography>
                    <materialis-typography variant="body" style="opacity: 0.7; line-height: 1.5;">
                        <%= __('friend_links.empty_desc') %>
                    </materialis-typography>
                </div>
            </s-card>
        </div>
    <% } %>
</div>

<script>
(function () {
    if (typeof IntersectionObserver === 'undefined') {
        document.querySelectorAll('[data-friends-reveal]').forEach(function (el) {
            el.classList.add('is-revealed');
        });
        return;
    }

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
    });

    document.querySelectorAll('[data-friends-reveal]').forEach(function (el) {
        observer.observe(el);
    });

    // 首屏元素立即触发
    requestAnimationFrame(function () {
        document.querySelectorAll('[data-friends-reveal]').forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('is-revealed');
                observer.unobserve(el);
            }
        });
    });
})();
</script>
