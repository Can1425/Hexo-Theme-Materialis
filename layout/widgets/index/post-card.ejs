<s-card
    class="post-card"
    variant="filled"
    onclick="location.href='<%= url_for(post.path) %>'"
    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='<%= url_for(post.path) %>'}"
    role="link"
    tabindex="0"
    aria-label="<%= post.title %>">

    <% if (post.cover) { %>
        <div class="post-card__media">
            <img class="post-card__img" src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" />
            <div class="post-card__media-overlay"></div>
            <% if (post.categories && post.categories.length > 0) { %>
                <span class="post-card__badge">
                    <material-icon name="folder"></material-icon>
                    <%= post.categories.data[0].name %>
                </span>
            <% } %>
        </div>
    <% } %>

    <div class="post-card__body">
        <div class="post-card__header">
            <% if (!post.cover && post.categories && post.categories.length > 0) { %>
                <span class="post-card__badge post-card__badge--inline">
                    <material-icon name="folder"></material-icon>
                    <%= post.categories.data[0].name %>
                </span>
            <% } %>
            <h3 class="post-card__title"><%= post.title %></h3>
        </div>

        <p class="post-card__excerpt">
            <%- truncate(strip_html(post.content), { length: post.cover ? 90 : 150 }) %>
        </p>

        <div class="post-card__meta">
            <span class="post-card__date">
                <material-icon name="calendar_today"></material-icon>
                <%= post.date.format('YYYY-MM-DD') %>
            </span>
            <div class="post-card__tags">
                <% if (post.tags && post.tags.length > 0) { %>
                    <% post.tags.data.slice(0, 2).forEach(function(tag) { %>
                        <span class="post-card__tag">
                            <material-icon name="sell"></material-icon>
                            <%= tag.name %>
                        </span>
                    <% }); %>
                    <% if (post.tags.length > 2) { %>
                        <span class="post-card__tag post-card__tag--more">+<%= post.tags.length - 2 %></span>
                    <% } %>
                <% } %>
            </div>
        </div>

        <div class="post-card__action">
            <span class="post-card__read-more"><%= __('index.read_more') %></span>
            <material-icon name="arrow_forward" class="post-card__arrow"></material-icon>
        </div>
    </div>
</s-card>
