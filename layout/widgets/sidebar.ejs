<aside class="sidebar-content" id="site-sidebar" aria-label="站点导航" data-open="true">
    <% if (theme.sidebar && (theme.sidebar.avatar || theme.sidebar.name || theme.sidebar.slogen)) { %>
    <div class="sidebar-user-card">
        <% if (theme.sidebar.avatar) { %>
            <s-avatar class="sidebar-user-avatar">
                <img class="nofancybox" src="<%= url_for(theme.sidebar.avatar) %>" alt="<%= theme.sidebar.name || config.title %>">
            </s-avatar>
        <% } %>
        <% if (theme.sidebar.name) { %>
            <div class="sidebar-user-name"><%= theme.sidebar.name %></div>
        <% } %>
        <% if (theme.sidebar.slogen) { %>
            <div class="sidebar-user-slogen"><%= theme.sidebar.slogen %></div>
        <% } %>
    </div>
    <% } %>

    <% if (theme.site_runtime && theme.site_runtime.enable && theme.site_runtime.start_date) { %>
    <div class="sidebar-runtime" data-runtime-start="<%= theme.site_runtime.start_date %>">
        <material-icon name="history"></material-icon>
        <div class="sidebar-runtime-text">
            <span class="sidebar-runtime-label"><%= __('sidebar.runtime') %></span>
            <span class="sidebar-runtime-value" data-runtime-value>…</span>
        </div>
    </div>
    <% } %>

    <nav class="nav-list">
        <% if (theme.nav && theme.nav.length > 0) { %>
            <% theme.nav.forEach(function(item) { %>
                <%
                    const currentPath = page.path || '';
                    const itemPath = item.url.replace(/^\//, '');
                    const isHome = item.url === '/';
                    const isActive = isHome
                        ? currentPath === '' || currentPath === 'index.html'
                        : currentPath === itemPath || currentPath.startsWith(itemPath.endsWith('/') ? itemPath : itemPath + '/');
                %>
                <a
                    class="nav-item<%= isActive ? ' is-active' : '' %>"
                    href="<%= url_for(item.url) %>"
                    <%= isActive ? 'aria-current="page"' : '' %>
                >
                    <material-icon name="<%= item.icon %>"></material-icon>
                    <span><%= item.name %></span>
                    <s-ripple></s-ripple>
                </a>
            <% }) %>
        <% } %>
    </nav>
</aside>
<button class="sidebar-scrim" id="sidebar-scrim" type="button" aria-label="关闭导航"></button>
