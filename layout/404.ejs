<div style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; padding: 40px;">
    
    <s-card readonly  style="width: 100%; max-width: 400px; padding: 40px 32px;">
        <div style="text-align: center;">
            <materialis-typography variant="h2" style="margin-bottom: 16px;">404</materialis-typography>
            <br>
            <materialis-typography variant="h6" style="opacity: 0.8;"><%= __('notfound.title') %></materialis-typography>
        </div>
    </s-card>

    <s-card readonly  style="width: 100%; max-width: 400px; padding: 32px;">
        <div style="display: flex; flex-direction: column; gap: 16px;">
            <s-button variant="filled" class="materialis-full-width" onclick="window.location.href='<%= url_for('/') %>'">
                <material-icon slot="start">home</material-icon>
                <%= __('notfound.home') %>
            </s-button>
            
            <s-button variant="outlined" class="materialis-full-width" onclick="history.back()">
                <material-icon slot="start">arrow_back</material-icon>
                <%= __('notfound.back') %>
            </s-button>
        </div>
    </s-card>

</div>
