<style>
.archives-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
}

/* 头部卡片 */
.archives-header {
    width: 100%;
    box-sizing: border-box;
    text-align: center;
    padding: 40px 32px;
    background-color: var(--s-color-primary-container);
    color: var(--s-color-on-primary-container);
}

.archives-header-count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.archives-header-count s-badge {
    background: color-mix(in srgb, var(--s-color-on-primary-container) 18%, transparent);
    color: var(--s-color-on-primary-container);
}

/* 年份卡片 */
.archives-year-card {
    width: 100%;
    background-color: var(--s-color-surface-container);
    color: var(--s-color-on-surface);
    border-radius: 20px;
    overflow: hidden;
}

.archives-year-header {
    padding: 24px 32px;
    background: var(--s-color-primary-container);
    color: var(--s-color-on-primary-container);
}

.archives-year-content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
}

.archives-year-avatar {
    background: color-mix(in srgb, var(--s-color-on-primary-container) 12%, transparent);
    color: var(--s-color-on-primary-container);
}

.archives-year-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
}

/* 文章列表 */
.archives-post-list {
    display: flex;
    flex-direction: column;
    padding: 0;
}

.archives-post-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 32px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    border-bottom: 1px solid var(--s-color-outline-variant);
}

.archives-post-item:last-child {
    border-bottom: none;
}

.archives-post-item:hover {
    background-color: var(--s-color-surface-container-highest);
    transform: translateX(4px);
}

.archives-post-icon {
    color: var(--s-color-primary);
    opacity: 0.8;
    flex-shrink: 0;
}

.archives-post-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.archives-post-title {
    font-weight: 500;
    margin-bottom: 6px;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.archives-post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    opacity: 0.7;
    line-height: 1.4;
    flex-wrap: wrap;
}

.archives-post-categories {
    display: flex;
    align-items: center;
    gap: 6px;
}

/* 分类 chip */
.archives-post-category {
    height: 22px;
    padding: 0 8px;
    font-size: 12px;
    background: var(--s-color-surface-container-highest);
    color: var(--s-color-on-surface-variant);
    border: none;
}

.archives-post-arrow {
    flex-shrink: 0;
    color: var(--s-color-outline);
    transition: transform 0.2s ease;
}

.archives-post-item:hover .archives-post-arrow {
    transform: translateX(4px);
}

/* 空状态 */
.archives-empty {
    width: 100%;
    max-width: 500px;
    background-color: var(--s-color-surface-container);
    color: var(--s-color-on-surface);
    border-radius: 24px;
    --s-color-outline: var(--s-color-on-surface-variant);
}

.archives-empty-icon {
    font-size: 56px;
    color: var(--s-color-primary);
    opacity: 0.7;
}

/* 平板设备 */
@media (max-width: 1024px) {
    .archives-page {
        padding: 32px 20px;
        gap: 20px;
    }

    .archives-header {
        padding: 32px 24px;
    }

    .archives-year-header {
        padding: 20px 24px;
    }

    .archives-post-item {
        padding: 18px 24px;
    }
}

/* 手机设备 */
@media (max-width: 768px) {
    .archives-page {
        padding: 24px 16px;
        gap: 16px;
    }

    .archives-header {
        padding: 24px 20px;
    }

    .archives-year-header {
        padding: 16px 20px;
    }

    .archives-year-content {
        gap: 16px;
    }

    .archives-post-item {
        padding: 16px 20px;
        gap: 12px;
    }

    .archives-post-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    .archives-post-categories {
        gap: 6px;
    }
}

/* 小屏手机 */
@media (max-width: 480px) {
    .archives-page {
        padding: 20px 12px;
        gap: 12px;
    }

    .archives-header {
        padding: 20px 16px;
    }

    .archives-year-header {
        padding: 16px;
    }

    .archives-year-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        text-align: left;
    }

    .archives-year-info {
        align-items: flex-start;
    }

    .archives-post-item {
        padding: 14px 16px;
        gap: 10px;
    }

    .archives-post-title {
        font-size: 15px;
    }

    .archives-post-meta {
        font-size: 13px;
    }
}
</style>

<div class="archives-page">
    <!-- 页面标题 -->
    <s-card readonly class="archives-header">
        <materialis-typography variant="h3" style="margin-bottom: 12px; font-weight: 500;"><%= __('diary.title') %></materialis-typography>
        <materialis-typography variant="h6" style="opacity: 0.8; font-weight: 400;">
            <span class="archives-header-count">
                <%= __('diary.total') %>
                <s-badge><%= site.posts.length %></s-badge>
                <%= __('diary.articles') %>
            </span>
        </materialis-typography>
    </s-card>

    <!-- 按年份分组 -->
    <%
        const postsByYear = {};
        site.posts.sort('-date').each(function(post) {
            const year = post.date.year();
            if (!postsByYear[year]) {
                postsByYear[year] = [];
            }
            postsByYear[year].push(post);
        });
    %>

    <% Object.keys(postsByYear).sort().reverse().forEach(function(year) { %>
        <!-- 年份卡片 -->
        <s-card readonly class="archives-year-card">
            <!-- 年份标题 -->
            <div class="archives-year-header">
                <div class="archives-year-content">
                    <s-avatar class="archives-year-avatar">
                        <material-icon name="calendar_today"></material-icon>
                    </s-avatar>
                    <div class="archives-year-info">
                        <materialis-typography variant="h5" style="font-weight: 500; color: inherit;">
                            <%= year %> <%= __('diary.year') %>
                        </materialis-typography>
                        <materialis-typography variant="body" style="opacity: 0.8; color: inherit;">
                            <%= postsByYear[year].length %> <%= __('diary.articles') %>
                        </materialis-typography>
                    </div>
                </div>
            </div>

            <!-- 文章列表 -->
            <div class="archives-post-list">
                <% postsByYear[year].forEach(function(post, index) { %>
                    <a href="<%= url_for(post.path) %>" class="archives-post-item">
                        <material-icon class="archives-post-icon" name="article"></material-icon>

                        <div class="archives-post-content">
                            <div class="archives-post-title">
                                <%= post.title %>
                            </div>
                            <div class="archives-post-meta">
                                <span><%= post.date.format('MM-DD') %></span>
                                <% if (post.categories && post.categories.length) { %>
                                    <span>·</span>
                                    <div class="archives-post-categories">
                                        <% post.categories.forEach(function(cat, catIndex) { %>
                                            <s-chip readonly class="archives-post-category" variant="assist"><%= cat.name %></s-chip>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <material-icon class="archives-post-arrow" name="chevron_right"></material-icon>
                    </a>
                <% }); %>
            </div>
        </s-card>
    <% }); %>

    <!-- 空状态 -->
    <% if (!site.posts || site.posts.length === 0) { %>
        <s-card readonly class="archives-empty">
            <s-empty>
                <material-icon class="archives-empty-icon" name="article"></material-icon>
                <materialis-typography variant="h5" style="margin-bottom: 8px; font-weight: 500; color: inherit;">
                    <%= __('diary.no_articles') %>
                </materialis-typography>
                <materialis-typography variant="body" style="opacity: 0.7; line-height: 1.5; color: inherit;">
                    <%= __('diary.no_articles_desc') %>
                </materialis-typography>
            </s-empty>
        </s-card>
    <% } %>
</div>
