<!DOCTYPE html>
<html lang="<%- config.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="preconnect" href="https://lib.baomitu.com" crossorigin>
    <link rel="preconnect" href="https://cdn.staticfile.org" crossorigin>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons&display=swap" rel="stylesheet">
    <script defer src="https://unpkg.com/sober@2.0.0-alpha.16/dist/sober.min.js"></script>
    <script defer src="https://unpkg.com/sober@2.0.0-alpha.16/dist/theme.min.js"></script>
    <script defer src="<%= url_for('/js/sober-adapter.js') %>"></script>

    <% if (theme.font.primary === 'lxwk') { %>
        <link rel="stylesheet" href="<%= url_for('/fonts/lxwk/lxwk.css') %>">
    <% } else if (theme.font.primary === 'dingtalk') { %>
        <link rel="stylesheet" href="<%= url_for('/fonts/dingtalk/DingTalk.css') %>">
    <% } else if (theme.font.primary === 'pingfang') { %>
        <link rel="stylesheet" href="<%= url_for('/fonts/pingfang/pingfang.css') %>">
    <% } %>

    <%- css('css/style.css') %>
    <%- css('css/color.css') %>
    <%- css('css/sober-adapter.css') %>
    <%- css('css/widgets/index/post-card.css') %>
    <%- css('css/widgets/page-transition.css') %>
    <%- css('css/widgets/loading.css') %>

    <!-- KaTeX 数学公式 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous">
    <!-- Markdown 增强样式（mark 高亮、数学公式容器） -->
    <style>
        mark {
            background: color-mix(in srgb, var(--s-color-tertiary) 24%, transparent);
            color: var(--s-color-on-surface);
            padding: 0.1em 0.3em;
            border-radius: 4px;
        }
        .katex-block {
            overflow-x: auto;
            overflow-y: hidden;
            padding: 12px 0;
            text-align: center;
        }
        .katex-inline {
            display: inline;
        }
        .katex-inline .katex,
        .katex-block .katex {
            font-size: 1.1em;
        }
        .katex-block .katex {
            font-size: 1.21em;
        }
    </style>

    <% if (theme.custom && theme.custom.css) { %>
        <% theme.custom.css.forEach(function(cssFile) { %>
            <link rel="stylesheet" href="<%- url_for(cssFile) %>">
        <% }) %>
    <% } %>
    <% if (theme.custom && theme.custom.head) { %>
        <%- theme.custom.head %>
    <% } %>
</head>
<body>
    <s-page id="materialis-page" class="materialis-page" theme="auto">
        <div id="md3-loading-overlay" class="md3-loading-overlay" role="status" aria-live="polite" aria-label="页面加载中">
            <div class="md3-loading-brand"><%= config.title %></div>
            <s-loading class="materialis-page-loading" variant="contained" aria-hidden="true"></s-loading>
            <span class="materialis-loading-label">页面加载中</span>
        </div>

        <%- include('widgets/appbar') %>
        <%- include('widgets/sidebar') %>

        <% if (typeof page !== 'undefined' && page.layout === 'post') { %>
        <div class="reading-progress-bar" id="reading-progress-bar">
            <div class="reading-progress-fill" id="reading-progress-fill"></div>
        </div>
        <% } %>

        <main class="main">
            <div class="page-transition-container<%= (typeof page !== 'undefined' && page.layout === 'post') ? ' post-transition-container' : '' %>">
                <%- body %>
            </div>
        </main>

        <s-fab class="back-to-top-fab" id="back-to-top-fab" variant="primary" size="small" aria-label="回到顶部">
            <material-icon name="arrow_upward"></material-icon>
        </s-fab>

        <%- include('widgets/footer', { isPost: (typeof page !== 'undefined' && page.layout === 'post') }) %>
        <%- include('widgets/music') %>

        <% if (theme.privacy_consent && theme.privacy_consent.enable) { %>
            <%- include('widgets/privacy-consent') %>
        <% } %>

        <% if (theme.interceptor && theme.interceptor.enable) { %>
            <%- include('widgets/links.ejs') %>
        <% } %>

        <% if (theme.custom && theme.custom.footer) { %>
            <%- theme.custom.footer %>
        <% } %>
    </s-page>

    <script type="module" src="<%= url_for('/js/loading.js') %>"></script>
    <script defer src="<%= url_for('/js/widgets/appbar.js') %>"></script>
    <script defer src="<%= url_for('/js/page-transition.js') %>"></script>
    <script>
    (function () {
        var fab = document.getElementById('back-to-top-fab');
        if (!fab) return;
        var ticking = false;
        function update() {
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            fab.classList.toggle('is-visible', scrollTop > 300);
            ticking = false;
        }
        window.addEventListener('scroll', function () {
            if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        fab.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        update();
    })();

    // ===== 阅读进度条 =====
    (function () {
        var fill = document.getElementById('reading-progress-fill');
        if (!fill) return;
        var ticking = false;

        function updateProgress() {
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            var scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            var progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
            progress = Math.max(0, Math.min(100, progress));
            fill.style.width = progress + '%';
            ticking = false;
        }

        window.addEventListener('scroll', function () {
            if (!ticking) { window.requestAnimationFrame(updateProgress); ticking = true; }
        }, { passive: true });
        window.addEventListener('resize', function () {
            if (!ticking) { window.requestAnimationFrame(updateProgress); ticking = true; }
        }, { passive: true });
        updateProgress();
    })();
    </script>

    <% if (theme.custom && theme.custom.js) { %>
        <% theme.custom.js.forEach(function(jsFile) { %>
            <script src="<%- url_for(jsFile) %>"></script>
        <% }) %>
    <% } %>

    <% if (theme.memorial_days && theme.memorial_days.enable) { %>
    <script>
    (function () {
        var today = new Date();
        var todayStr = (today.getMonth() + 1) + '.' + today.getDate();
        var memorialDays = JSON.parse('<%- JSON.stringify(theme.memorial_days.dates || []) %>');
        if (memorialDays.includes(todayStr)) document.documentElement.classList.add('memorial-day');
    })();
    </script>
    <% } %>

    <script>
    console.log(`
███╗   ███╗ █████╗ ████████╗███████╗██████╗ ██╗ █████╗ ██╗     ██╗███████╗
████╗ ████║██╔══██╗╚══██╔══╝██╔════╝██╔══██╗██║██╔══██╗██║     ██║██╔════╝
██╔████╔██║███████║   ██║   █████╗  ██████╔╝██║███████║██║     ██║███████╗
██║╚██╔╝██║██╔══██║   ██║   ██╔══╝  ██╔══██╗██║██╔══██║██║     ██║╚════██║
