`);

    // ===== KaTeX 数学渲染（按需加载） =====
    (function () {
        var inlines = document.querySelectorAll('.katex-inline');
        var blocks  = document.querySelectorAll('.katex-block');
        if (inlines.length === 0 && blocks.length === 0) return;

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js';
        script.onload = function () {
            // 渲染行内公式
            for (var i = 0; i < inlines.length; i++) {
                var el = inlines[i];
                var tex = el.textContent || el.innerText;
                try {
                    katex.render(tex, el, { throwOnError: false, displayMode: false });
                } catch (e) {
                    el.textContent = tex;
                }
            }
            // 渲染块级公式
            for (var j = 0; j < blocks.length; j++) {
                var el2 = blocks[j];
                var tex2 = el2.textContent || el2.innerText;
                try {
                    katex.render(tex2, el2, { throwOnError: false, displayMode: true });
                } catch (e) {
                    el2.textContent = tex2;
                }
            }
        };
        document.head.appendChild(script);
    })();
    </script>
</body>
</html>
