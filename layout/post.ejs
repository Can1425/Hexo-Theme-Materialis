    }
    
    .mac-code-dot {
        width: 10px;
        height: 10px;
    }
    
    .mac-code-title {
        font-size: 0.72rem;
    }
}

/* =====================================================
   macOS 风格代码块（重构版）
   支持 Hexo highlight.js 输出的 figure.highlight 结构
   ===================================================== */
.mac-code-block {
    margin: 1.6em 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--s-color-surface-container-high);
    border: 1px solid color-mix(in srgb, var(--s-color-outline) 12%, transparent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
    position: relative;
}

.mac-code-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--s-color-surface-container-highest);
    border-bottom: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 50%, transparent);
    position: relative;
}

/* 三个交通灯圆点 */
.mac-code-dots {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    flex-shrink: 0;
}

.mac-code-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
}

.mac-code-dot.red { background: #ff5f57; }
.mac-code-dot.yellow { background: #febc2e; }
.mac-code-dot.green { background: #28c840; }

/* 居中语言标题 */
.mac-code-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--s-color-on-surface-variant);
    font-family: var(--materialis-font-family);
    max-width: 50%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
}

/* 右侧操作按钮 */
.mac-code-actions {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.mac-code-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    border-radius: 8px;
    color: var(--s-color-on-surface-variant);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    padding: 0;
}

.mac-code-btn:hover {
    background: var(--s-color-surface-container);
    color: var(--s-color-primary);
}

.mac-code-btn.copied {
    color: var(--s-color-success);
}

.mac-code-btn material-icon {
    font-size: 18px;
}

/* 代码主体区 */
.mac-code-body {
    overflow: hidden;
}

/* 重置 article-content 通用表格样式对代码表格的干扰 */
.article-content .mac-code-block figure {
    margin: 0;
}

.article-content .mac-code-block table {
    display: table;
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
}

.article-content .mac-code-block table thead,
.article-content .mac-code-block table th,
.article-content .mac-code-block table td {
    background: transparent;
    color: inherit;
    border-bottom: none;
    padding: 0;
}

.article-content .mac-code-block tbody tr,
.article-content .mac-code-block tbody tr:nth-child(even),
.article-content .mac-code-block tbody tr:hover {
    background: transparent;
}

/* 行号列 */
.article-content .mac-code-block .gutter {
    background: var(--s-color-surface-container);
    border-right: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 40%, transparent);
    padding: 14px 8px 14px 14px;
    text-align: right;
    user-select: none;
    vertical-align: top;
    white-space: nowrap;
}

.article-content .mac-code-block .gutter pre {
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    margin: 0;
    color: var(--s-color-on-surface-variant);
    opacity: 0.6;
    font-family: var(--materialis-font-family-mono);
    font-size: 0.875rem;
    line-height: 1.6;
}

/* 代码列 */
.article-content .mac-code-block .code {
    padding: 14px 16px;
    vertical-align: top;
}

.article-content .mac-code-block .code pre {
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    margin: 0;
    overflow-x: auto;
    font-family: var(--materialis-font-family-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--s-color-on-surface);
}

/* 裸 pre（未走 highlight.js 的代码）回退 */
.article-content .mac-code-block > .mac-code-body > pre {
    margin: 0;
    padding: 14px 16px;
    background: transparent !important;
    border-radius: 0 !important;
    overflow-x: auto;
    font-family: var(--materialis-font-family-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--s-color-on-surface);
}

/* 横向滚动条 */
.article-content .mac-code-block pre {
    scrollbar-width: thin;
    scrollbar-color: var(--s-color-outline-variant) transparent;
}

.article-content .mac-code-block pre::-webkit-scrollbar {
    height: 8px;
}

.article-content .mac-code-block pre::-webkit-scrollbar-thumb {
    background: var(--s-color-outline-variant);
    border-radius: 4px;
}

.article-content .mac-code-block pre::-webkit-scrollbar-thumb:hover {
    background: var(--s-color-outline);
}

/* Hexo highlight 行标记 */
.article-content .mac-code-block .marked-line {
    background: color-mix(in srgb, var(--s-color-primary) 8%, transparent);
    display: block;
    margin: 0 -16px;
    padding: 0 16px;
}

/* 折叠状态 */
.mac-code-block.is-collapsed .mac-code-body {
    display: none;
}

/* 代码块内链接不上色 */
.article-content .mac-code-block a {
    border-bottom: none;
}

/* =====================================================
   Markdown 格式补全
   ===================================================== */

/* h5 / h6 */
.article-content h5,
.article-content h6 {
    color: var(--s-color-primary);
    margin-top: 1.2em;
    margin-bottom: 0.6em;
    font-weight: 500;
}

.article-content h5 { font-size: 1.05rem; }
.article-content h6 { font-size: 0.95rem; opacity: 0.85; }

/* 加粗 / 斜体 / 删除线 */
.article-content strong {
    font-weight: 600;
    color: var(--s-color-on-surface);
}

.article-content em {
    font-style: italic;
}

.article-content del {
    opacity: 0.6;
}

/* 键盘按键 */
.article-content kbd {
    display: inline-block;
    padding: 2px 7px;
    font-family: var(--materialis-font-family-mono);
    font-size: 0.8em;
    line-height: 1.4;
    color: var(--s-color-on-surface);
    background: var(--s-color-surface-container-highest);
    border: 1px solid color-mix(in srgb, var(--s-color-outline) 40%, transparent);
    border-bottom-width: 2px;
    border-radius: 6px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
    vertical-align: middle;
    margin: 0 2px;
}

/* 高亮标记 */
.article-content mark {
    background: var(--s-color-tertiary-container);
    color: var(--s-color-on-tertiary-container);
    padding: 1px 5px;
    border-radius: 4px;
}

/* 上下标 */
.article-content sup,
.article-content sub {
    font-size: 0.75em;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
}

.article-content sup { top: -0.5em; }
.article-content sub { bottom: -0.25em; }

/* 任务列表（GFM task list） */
.article-content ul.contains-task-list,
.article-content li.task-list-item {
    list-style: none;
}

.article-content li.task-list-item {
    padding-left: 0;
    margin-left: -18px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}

.article-content input[type="checkbox"].task-list-item-checkbox {
    margin: 0.35em 0 0 0;
    flex-shrink: 0;
    accent-color: var(--s-color-primary);
    width: 16px;
    height: 16px;
    cursor: default;
}

/* 嵌套列表缩进 */
.article-content ul ul,
.article-content ol ol,
.article-content ul ol,
.article-content ol ul {
    margin: 6px 0 0 0;
}

/* 定义列表 */
.article-content dl {
    margin: 1em 0;
    padding: 12px 18px;
    background: color-mix(in srgb, var(--s-color-surface-container) 50%, transparent);
    border-radius: 12px;
}

.article-content dt {
    font-weight: 600;
    color: var(--s-color-primary);
    margin-top: 10px;
}

.article-content dt:first-child {
    margin-top: 0;
}

.article-content dd {
    margin: 4px 0 0 0;
    padding-left: 16px;
    color: var(--s-color-on-surface-variant);
    line-height: 1.7;
}

/* 引用块内的列表 */
.article-content blockquote ul,
.article-content blockquote ol {
    margin: 8px 0 0 0;
}

/* 图片标题 */
.article-content .caption {
    color: var(--s-color-on-surface-variant);
    display: block;
    font-size: 0.85em;
    margin-top: 0.4em;
    text-align: center;
    opacity: 0.8;
}

/* 脚注 */
.article-content .footnotes {
    margin-top: 2em;
    padding-top: 1em;
    border-top: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 60%, transparent);
    font-size: 0.875em;
    color: var(--s-color-on-surface-variant);
}

.article-content .footnote-ref a,
.article-content .footnote a {
    border-bottom: none;
}

/* ===== 阅读优先的文章布局 ===== */
.post-layout {
    padding-bottom: clamp(48px, 8vw, 96px);
}

/* 页面转场容器默认使用 overflow:hidden，会阻断文章目录的 sticky 吸附。 */
.post-transition-container {
    height: auto;
    overflow: visible;
}

.post-layout .post-banner {
    max-width: 1180px;
    margin: 24px auto 12px;
    padding: 0 20px;
}

.post-layout .post-banner .banner-title {
    min-height: 0;
    padding: clamp(24px, 4vw, 44px) clamp(24px, 5vw, 56px);
    box-sizing: border-box;
    border-radius: 28px;
}

.post-layout .post-banner .banner-title-text1 {
    max-width: 20ch;
    margin: 0 0 20px;
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    line-height: 1.12;
    overflow-wrap: anywhere;
}

.post-container {
    max-width: 1180px;
    padding: 20px;
    gap: 24px;
}

.post-reading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: start;
    gap: 24px;
}

.post-reading-column {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.post-card-wide,
.post-card-nav,
.post-card-comment {
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 64%, transparent);
}

.post-card-wide {
    padding: clamp(24px, 5vw, 56px);
    border-radius: 28px;
    background: var(--s-color-surface);
}

.post-toc-rail {
    min-width: 0;
    position: sticky;
    top: 80px;
    align-self: start;
}

.post-toc-rail-panel {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 112px);
    padding: 18px 10px 14px;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--s-color-outline-variant) 64%, transparent);
    border-radius: 24px;
    background: var(--s-color-surface-container-low);
}

.post-toc-rail-title {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 12px;
    color: var(--s-color-on-surface);
    font-size: 0.95rem;
    font-weight: 650;
}

.post-toc-rail-title material-icon {
    color: var(--s-color-primary);
    font-size: 20px;
}

.post-toc-rail-container {
    min-height: 96px;
    padding: 0;
}

.post-toc-rail-container .toc-link {
    padding: 7px 9px;
    font-size: 0.84rem;
}

.post-toc-rail-count {
    padding: 10px 10px 0;
    color: var(--s-color-on-surface-variant);
    font-size: 0.75rem;
}

.post-card-wide > div {
    width: 100%;
}

.post-card-wide .article-content {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.85;
}

.post-card-nav,
.post-card-comment {
    width: 100%;
    margin-inline: 0;
    border-radius: 24px;
    background: var(--s-color-surface-container-low);
}

.post-card-nav {
    padding: clamp(18px, 3vw, 28px);
}

.post-card-comment {
    padding: clamp(22px, 4vw, 40px);
}

.post-card-comment > div {
    width: 100%;
}

.post-card-comment materialis-typography {
    display: block;
    margin-bottom: 24px !important;
    text-align: left !important;
}

@media (max-width: 768px) {
    .post-layout .post-banner {
        margin-top: 16px;
        padding: 0 16px;
    }

    .post-layout .post-banner .banner-title {
        padding: 28px 24px 24px;
        border-radius: 24px;
    }

    .post-layout .post-banner .banner-title-text1 {
        margin-bottom: 16px;
        font-size: clamp(1.9rem, 9vw, 2.5rem);
    }

    .post-container {
        padding: 12px 16px;
        gap: 16px;
    }

    .post-card-wide {
        padding: 24px 20px;
        border-radius: 24px;
    }

    .post-card-wide .article-content {
        font-size: 1rem;
        line-height: 1.8;
    }

    .post-card-nav,
    .post-card-comment {
        border-radius: 20px;
    }
}

@media (max-width: 1179px) {
    .post-reading-grid {
        display: block;
    }

    .post-toc-rail {
        display: none;
    }
}
</style>

<%
  const _plainText = strip_html(page.content);
  const _wordCount = _plainText ? _plainText.length : 0;
  const _readTime = Math.max(1, Math.ceil(_wordCount / 300));
%>

<!-- 阅读进度条 -->
<div class="reading-progress-bar" id="reading-progress-bar"></div>

<section class="layout-main post-layout">
    <%- include('widgets/post-banner', {titleText1: page.title}) %>

    <div class="post-container">
        <div class="post-reading-grid">
            <div class="post-reading-column">
                <!-- 内容卡片 -->
                <s-card readonly variant="filled" class="post-card-wide">
                    <div>
                        <div class="article-content">
                            <%- page.content %>
                        </div>
                    </div>
                </s-card>

                <!-- 上一篇/下一篇导航 -->
                <s-card readonly variant="filled" class="post-card-nav">
                    <div>
                        <div class="post-navigation">
                            <% if (page.prev) { %>
                                <a href="<%= url_for(page.prev.path) %>" class="nav-button">
                                    <span class="nav-label"><%= __('post.prev') %></span>
                                    <span class="nav-title"><%= page.prev.title %></span>
                                </a>
                            <% } else { %>
                                <a class="nav-button disabled">
                                    <span class="nav-label"><%= __('post.prev') %></span>
                                    <span class="nav-title"><%= __('post.none') %></span>
                                </a>
                            <% } %>

                            <% if (page.next) { %>
                                <a href="<%= url_for(page.next.path) %>" class="nav-button">
                                    <span class="nav-label"><%= __('post.next') %></span>
                                    <span class="nav-title"><%= page.next.title %></span>
                                </a>
                            <% } else { %>
                                <a class="nav-button disabled">
                                    <span class="nav-label"><%= __('post.next') %></span>
                                    <span class="nav-title"><%= __('post.none') %></span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </s-card>

                <!-- 评论卡片 -->
                <s-card readonly variant="filled" class="post-card-comment">
                    <div>
                        <materialis-typography variant="h5" style="color: var(--s-color-primary);">
                            <%= __('post.comment') %>
                        </materialis-typography>
                        <% if (theme.comment && theme.comment.service) { %>
                            <% if (theme.comment.service === 'twikoo') { %>
                                <%- include('widgets/comments/twikoo.ejs') %>
                            <% } else if (theme.comment.service === 'waline') { %>
                                <%- include('widgets/comments/waline.ejs') %>
                            <% } else if (theme.comment.service === 'giscus') { %>
                                <%- include('widgets/comments/giscus.ejs') %>
                            <% } else { %>
                                <div style="text-align: center; padding: 2rem;">
                                    <materialis-typography variant="body2" style="color: var(--s-color-on-surface-variant);">
                                        <%= __('post.comment_disabled') %>
                                    </materialis-typography>
                                </div>
                            <% } %>
                        <% } else { %>
                            <div style="text-align: center; padding: 2rem;">
                                <materialis-typography variant="body2" style="color: var(--s-color-on-surface-variant);">
                                    <%= __('post.comment_disabled') %>
                                </materialis-typography>
                            </div>
                        <% } %>
                    </div>
                </s-card>
            </div>

            <aside class="post-toc-rail" aria-label="文章目录">
                <div class="post-toc-rail-panel">
                    <div class="post-toc-rail-title">
                        <material-icon name="menu_book"></material-icon>
                        <span>目录</span>
                    </div>
                    <div id="post-toc-rail-container" class="toc-container post-toc-rail-container">
                        <div class="toc-placeholder">
                            <material-icon name="menu_book"></material-icon>
                            <div class="toc-placeholder-text">正在解析标题…</div>
                        </div>
                    </div>
                    <div id="post-toc-rail-count" class="post-toc-rail-count"></div>
                </div>
            </aside>
        </div>
    </div>
</section>

<!-- macOS 风格代码块（外部脚本，defer 延迟加载） -->
<script defer src="/js/post-codeblock.js"></script>

<script>
// 阅读进度条（使用 requestAnimationFrame 节流，性能友好）
(function () {
    var progressBar = document.getElementById('reading-progress-bar');
    if (!progressBar) return;

    var ticking = false;

    function update() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = docHeight > 0 ? (scrollTop / docHeight) : 0;
        if (progress < 0) progress = 0;
        if (progress > 1) progress = 1;

        progressBar.style.width = (progress * 100) + '%';

        ticking = false;
    }

    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(update);
            ticking = true;
        }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
})();
</script>
