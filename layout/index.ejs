<%- include('widgets/index/home-banner') %>
<section class="layout-main">
    <div class="articles-container">
        <% 
            const sortedPosts = Array.from(site.posts.data || site.posts).sort((a, b) => {
                const dateA = a.date ? new Date(a.date).getTime() : new Date(a.updated).getTime();
                const dateB = b.date ? new Date(b.date).getTime() : new Date(b.updated).getTime();
                
                return dateB - dateA;
            });
        %>
        
        <% if (sortedPosts && sortedPosts.length > 0) { %>
            <% sortedPosts.forEach((post) => { %>
                <%- include('widgets/index/post-card', {post: post}) %>
            <% }); %>
        <% } else { %>
            <s-card readonly class="no-articles" variant="filled">
                <materialis-typography variant="h4" style="margin-bottom: 1rem; color: var(--s-color-on-surface);">
                    <%= __('index.no_articles') %>
                </materialis-typography>
                <materialis-typography variant="body1" style="color: var(--s-color-on-surface-variant);">
                    <%= __('index.no_articles_desc') %>
                </materialis-typography>
            </s-card>
        <% } %>
    </div>
</section>
